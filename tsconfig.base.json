{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@ads/config": ["./packages/config/src/index.ts"],
      "@ads/config/*": ["./packages/config/src/*"],
      "@ads/lib": ["./packages/lib/src/index.ts"],
      "@ads/lib/*": ["./packages/lib/src/*"],
      "@ads/types": ["./packages/types/src/index.ts"],
      "@ads/types/*": ["./packages/types/src/*"],
      "@ads/ui": ["./packages/ui/src/index.ts"],
      "@ads/ui/*": ["./packages/ui/src/*"]
    }
  }
}
