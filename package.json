{
  "name": "ads",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "pnpm --filter @ads/app dev",
    "dev:admin": "pnpm --filter @ads/admin dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "ui:add:app": "shadcn add --cwd apps/app",
    "ui:add:admin": "shadcn add --cwd apps/admin",
    "ui:info:app": "shadcn info --cwd apps/app",
    "ui:info:admin": "shadcn info --cwd apps/admin"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "shadcn": "^4.6.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
